# Copy to .env.local and fill in. Never commit real values.

# Public site URL, used for share links and link previews
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Step 7 accounts, Step 8 database). From Supabase: Project Settings > API Keys.
# Without these, sign-in shows "Accounts open very soon".
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_...), or the legacy anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# A secret key (sb_secret_...), or the legacy service_role key. Server only, never exposed
# to the browser. Used by seeding and admin jobs.
SUPABASE_SERVICE_ROLE_KEY=

# Sign-in by mobile number on the live site. Off until SMS codes are set up (docs/LAUNCH.md,
# step 8): hosts sign in with Google. Set to "on" to offer it again.
# PHONE_SIGN_IN=on

# Sign-in with a code sent by email: on whenever SUPABASE_SERVICE_ROLE_KEY and RESEND_API_KEY
# are set (the site sends the code itself). Needs supabase-update-email-sign-in.sql run once.
# Set to "off" to hide it.
# EMAIL_SIGN_IN=off

# Local work and tests without Supabase: any number signs in with the code 123456.
# Ignored when the Supabase keys are set, and never active on the production site.
# SHUBHDWAR_AUTH_PREVIEW=1

# Emails (welcome, payment receipts, unfinished-draft reminders): docs/EMAILS.md.
# Nothing is sent until the Resend key is set.
RESEND_API_KEY=
# Sender, on the domain verified in Resend. Defaults to Shubh Invitation <hello@shubhinvitations.com>
EMAIL_FROM=
# Optional: where replies to these emails go
EMAIL_REPLY_TO=
# Any long random string; Vercel Cron sends it to the daily reminder job
CRON_SECRET=
