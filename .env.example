# Copy to .env.local and fill in. Never commit real values.

# Public site URL, used for share links and link previews
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (added in Step 7–8)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Waitlist (Step 3). Each sign-up is POSTed here as JSON until the database arrives in Step 8.
# Any endpoint that accepts JSON works: a Google Apps Script web app, Zapier, Make, Formspree.
# Without it the form tells people it couldn't save, rather than dropping their details.
WAITLIST_WEBHOOK_URL=
# Set to 1 locally to log sign-ups to the console instead. Ignored on the live Vercel site.
WAITLIST_LOG_ONLY=
